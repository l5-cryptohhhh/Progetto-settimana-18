# Copia di riferimento delle variabili d'ambiente, con valori FINTI.
# I valori veri vanno in backend/.env (escluso dal .gitignore) oppure nella
# configurazione di avvio di IntelliJ. Questo file invece va su GitHub: niente segreti qui.
# ATTENZIONE: il backend NON legge questo file. Cambiare un valore qui non cambia niente.

# --- database locale ---
DB_URL=jdbc:postgresql://localhost:5432/salone_auto
DB_USERNAME=postgres
DB_PASSWORD=la-tua-password-di-postgres

# --- firma dei token ---
# Almeno 32 caratteri. Se ne genera una con: openssl rand -base64 48
JWT_SECRET=sostituisci-con-una-stringa-casuale-lunga-almeno-32-caratteri
JWT_DURATA_ORE=12

# --- primo amministratore, creato all'avvio se non esiste ---
ADMIN_EMAIL=admin@esempio.it
ADMIN_NOME=Amministratore
ADMIN_PASSWORD=scegli-una-password-lunga

# --- Gmail ---
# MAIL_PASSWORD e' una password per le app generata da Google
# (https://myaccount.google.com/apppasswords, serve la verifica in due passaggi),
# non la password con cui si entra in Gmail. 16 lettere, senza spazi.
MAIL_USERNAME=tuo.indirizzo@gmail.com
MAIL_PASSWORD=abcdefghijklmnop

# --- frontend ---
# L'indirizzo esatto, senza barra finale.
ALLOWED_ORIGIN=http://localhost:5173
